<Window x:Class="SpeakerLayoutEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dolby Speaker Layout" Width="1280" Height="760"
        WindowStartupLocation="CenterScreen"
        MinWidth="980" MinHeight="640" Background="#F3F5F6"
        FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#4B535A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Margin" Value="0,4,0,12" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#252A2E" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" Height="54" Background="#252B30"
            BorderBrush="#161A1D" BorderThickness="0,0,0,1">
      <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Style="{StaticResource IconButton}" Content="&#xE8E5;"
                ToolTip="Abrir perfil" Click="OpenClick" />
        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE74E;"
                ToolTip="Guardar perfil" Click="SaveClick" />
        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE792;"
                ToolTip="Guardar como" Click="SaveAsClick" />
        <TextBlock Grid.Column="4" x:Name="PathText" Foreground="#DCE1E4"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="5" Text="7.1.4" Foreground="#9FD4B2" FontWeight="SemiBold"
                   VerticalAlignment="Center" FontSize="15" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Height="30" Background="#E2E6E8"
            BorderBrush="#C7CDD1" BorderThickness="0,1,0,0">
      <TextBlock x:Name="StatusText" Margin="12,0" VerticalAlignment="Center"
                 Text="Listo" />
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="320" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#E9EDEF" BorderBrush="#C9CFD3"
              BorderThickness="0,0,1,0">
        <DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" Text="PARLANTES" FontSize="11"
                     Foreground="#596168" FontWeight="SemiBold" Margin="4,4,0,8" />
          <ListBox x:Name="SpeakerList" BorderThickness="0" Background="Transparent"
                   SelectionChanged="SpeakerSelectionChanged"
                   DisplayMemberPath="Name" />
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Margin="18,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="190" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="4,0,4,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="LayoutNameText" FontSize="20" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" x:Name="RouteLegend" Orientation="Horizontal"
                      VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Row="1" Background="White" BorderBrush="#C9CFD3" BorderThickness="1">
          <Canvas x:Name="TopCanvas" ClipToBounds="True"
                  SizeChanged="CanvasSizeChanged"
                  MouseMove="CanvasMouseMove"
                  MouseLeftButtonUp="CanvasMouseUp" />
        </Border>
        <Grid Grid.Row="2" Margin="0,14,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="ELEVACION" FontSize="11" Foreground="#596168"
                     FontWeight="SemiBold" Margin="4,0,0,6" />
          <Border Grid.Row="1" Background="White" BorderBrush="#C9CFD3" BorderThickness="1">
            <Canvas x:Name="ElevationCanvas" ClipToBounds="True"
                    SizeChanged="CanvasSizeChanged"
                    MouseMove="CanvasMouseMove"
                    MouseLeftButtonUp="CanvasMouseUp" />
          </Border>
        </Grid>
      </Grid>

      <Border Grid.Column="2" Background="#FAFBFB" BorderBrush="#C9CFD3"
              BorderThickness="1,0,0,0">
        <TabControl Background="Transparent" BorderThickness="0" Margin="12">
          <TabItem Header="Parlante">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="6,16,6,6">
                <TextBlock x:Name="SelectedNameText" FontSize="18" FontWeight="SemiBold"
                           Margin="0,0,0,18" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Azimut" />
                  <TextBlock Grid.Column="1" x:Name="AzimuthValue" TextAlignment="Right" />
                </Grid>
                <Slider x:Name="AzimuthSlider" Minimum="-180" Maximum="180"
                        ValueChanged="SpeakerControlChanged" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Elevacion" />
                  <TextBlock Grid.Column="1" x:Name="ElevationValue" TextAlignment="Right" />
                </Grid>
                <Slider x:Name="ElevationSlider" Minimum="-30" Maximum="90"
                        ValueChanged="SpeakerControlChanged" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Nivel" />
                  <TextBlock Grid.Column="1" x:Name="TrimValue" TextAlignment="Right" />
                </Grid>
                <Slider x:Name="TrimSlider" Minimum="-24" Maximum="12"
                        ValueChanged="SpeakerControlChanged" />
                <TextBlock Text="Salida" Margin="0,4,0,6" />
                <ComboBox x:Name="OutputCombo" DisplayMemberPath="Name"
                          SelectionChanged="OutputSelectionChanged" Height="30" />
                <TextBlock Text="Ganancia de prueba" Margin="0,18,0,2" />
                <Slider x:Name="TestGainSlider" Minimum="0" Maximum="0.25" Value="0.08" />
                <Button Height="38" Margin="0,10,0,0" Click="TestSpeakerClick"
                        HorizontalContentAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE768;"
                               FontSize="16" Margin="0,0,8,0" />
                    <TextBlock Text="Probar parlante" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Salidas">
            <DataGrid x:Name="OutputGrid" Margin="4,12,4,4" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" RowHeaderWidth="0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Ruta" Binding="{Binding Name}" IsReadOnly="True"
                                    Width="80" />
                <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}"
                                    Width="*" />
                <DataGridTextColumn Header="ms" Binding="{Binding DelayMilliseconds}"
                                    Width="48" />
                <DataGridTextColumn Header="Canales" Binding="{Binding SpeakersText}"
                                    IsReadOnly="True" Width="130" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>
  </DockPanel>
</Window>
