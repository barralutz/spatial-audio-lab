+VOID MatCaptureShutdown(_In_ PDRIVER_OBJECT DriverObject);
+
+_IRQL_requires_max_(DISPATCH_LEVEL)
+VOID MatCaptureWrite(
+    _In_ const WAVEFORMATEXTENSIBLE* Format,
